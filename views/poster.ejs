<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <ol>
        <% items.forEach(function(item) { %>
            <li>
            <%= item.name %> 
            <% if (item.artists) { %>
                by <%= item.artists.map(a => a.name).join(', ') %>
            <% } %>
            </li>
        <% }) %>
    </ol>
</body>
</html>