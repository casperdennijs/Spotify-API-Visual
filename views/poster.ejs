<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Spotify Festival</title>
    <link
        href="https://fonts.googleapis.com/css2?family=DynaPuff:wght@400..700&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/static/style.css">
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js" defer></script>
</head>

<body class="poster">
    <% const date=new Date(); const days=["Monday", "Tuesday" , "Wednesday" , "Thursday" , "Friday" , "Saturday"
        , "Sunday" ]; const month=["Jan", "Feb" , "Mar" , "Apr" , "May" , "Jun" , "Jul" , "Aug" , "Sep" , "Oct" , "Nov"
        , "Dec" ] %>
        <main>
            <div id="poster" class="poster bg-1">
                <h1 class="title">Your Spotify Festival</h1>
                <div class="day friday">
                    <h2>• <%= days[date.getDay()-1] %>, <%= date.getDate() %>
                                <%= month[date.getMonth()] %> •</h2>
                    <div class="headliner">
                        <% items.slice(0, 1).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                    <div class="featured">
                        <% items.slice(3, 6).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                    <div class="other">
                        <% items.slice(6, 12).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                </div>
                <div class="divider"></div>
                <div class="day saturday">
                    <h2>• <%= days[date.getDay()] %>, <%= date.getDate()+1 %>
                                <%= month[date.getMonth()] %> •</h2>
                    <div class="headliner">
                        <% items.slice(1, 2).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                    <div class="featured">
                        <% items.slice(12, 15).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                    <div class="other">
                        <% items.slice(15, 21).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                </div>
                <div class="divider"></div>
                <div class="day sunday">
                    <h2>• <%= days[date.getDay()+1] %>, <%= date.getDate()+2 %>
                                <%= month[date.getMonth()] %> •</h2>
                    <div class="headliner">
                        <% items.slice(2, 3).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                    <div class="featured">
                        <% items.slice(21, 24).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                    <div class="other">
                        <% items.slice(24, 30).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                </div>
            </div>
        </main>
        <aside>
            <h1>Customize your poster</h1>
            <section>
                <p>Poster title:</p>
                <form id="title">
                    <input type="text" maxlength="21" value="Your Spotify Festival">
                </form>
            </section>
            <section>
                <p>Choose your background:</p>
                <form id="background">
                    <label>
                        Beach
                        <img src="/static/images/beach.jpeg" width="100">
                        <input type="radio" id="beach" name="bg" checked>
                    </label>
                    <label for="party">
                        Party
                        <img src="/static/images/party.jpeg" width="100">
                        <input type="radio" id="party" name="bg">
                    </label>
                    <label for="winter">
                        Winter
                        <img src="/static/images/winter.jpeg" width="100">
                        <input type="radio" id="winter" name="bg">
                    </label>
                    <label for="custom">
                        Custom
                        <div>Custom</div>
                        <input type="radio" id="custom" name="bg">
                    </label>
                    <input type="text" id="customcolor" placeholder="Color (e.g. #202020)">
                    <input type="text" id="customimage" placeholder="Custom Image URL">
                </form>
            </section>
            <section>
                <p>Share Your Spotify Festival</p>
                <button id="download">Download image</button>
            </section>
        </aside>
        <script>
            document.getElementById("download").addEventListener("click", () => {
                const element = document.getElementById("poster");
                const title = document.querySelector("form#title input").value;

                function formatDate(date) {
                    const d = date.getDate();
                    const m = date.getMonth() + 1;
                    const y = date.getFullYear();
                    const h = date.getHours();
                    const min = date.getMinutes();

                    return `${d}${m}${y}${h}${min.toString().padStart(2, '0')}`;
                }
                const now = new Date();

                html2canvas(element, {
                    backgroundColor: null
                }).then(canvas => {
                    const dataUrl = canvas.toDataURL("image/png");

                    const link = document.createElement("a");
                    link.href = dataUrl;
                    link.download = `${title}_${formatDate(now)}`;
                    link.click();
                });
            });
        </script>
        <script>
            const titleEl = document.querySelector("h1.title");
            const titleInput = document.querySelector("form#title input");

            titleInput.addEventListener("input", (event) => {
                titleEl.textContent = event.target.value;
            })
        </script>
        <script>
            var r = document.querySelector(':root');
            var rs = getComputedStyle(r);
            const customcolorInput = document.querySelector("input#customcolor");
            const customimageInput = document.querySelector("input#customimage");

            customcolorInput.addEventListener("input", (event) => {
                r.style.setProperty('--custom-color', `${event.target.value}`);
                console.log("Custom color loaded");
            })

            customimageInput.addEventListener("input", (event) => {
                r.style.setProperty('--custom-image', `url(${event.target.value})`);
                console.log("Custom image loaded");
            })
        </script>
</body>

</html>