<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Spotify Festival</title>
    <link
        href="https://fonts.googleapis.com/css2?family=DynaPuff:wght@400..700&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
        integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/static/core.css">
    <link rel="stylesheet" href="/static/poster.css">
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js" defer></script>
</head>

<body>
    <% const date=new Date(); const days=["Monday", "Tuesday" , "Wednesday" , "Thursday" , "Friday" , "Saturday"
        , "Sunday" ]; const month=["Jan", "Feb" , "Mar" , "Apr" , "May" , "Jun" , "Jul" , "Aug" , "Sep" , "Oct" , "Nov"
        , "Dec" ] %>
        <main>
            <div id="poster" class="poster bg-1">
                <h1 class="title">Your Spotify Festival</h1>
                <div class="day friday">
                    <h2>• <%= days[date.getDay()-1] %>, <%= date.getDate() %>
                                <%= month[date.getMonth()] %> •</h2>
                    <div class="headliner">
                        <% items.slice(0, 1).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                    <div class="featured">
                        <% items.slice(3, 6).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                    <div class="other">
                        <% items.slice(12, 18).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                </div>
                <div class="divider"></div>
                <div class="day saturday">
                    <h2>• <%= days[date.getDay()] %>, <%= date.getDate()+1 %>
                                <%= month[date.getMonth()] %> •</h2>
                    <div class="headliner">
                        <% items.slice(1, 2).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                    <div class="featured">
                        <% items.slice(6, 9).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                    <div class="other">
                        <% items.slice(18, 24).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                </div>
                <div class="divider"></div>
                <div class="day sunday">
                    <h2>• <%= days[date.getDay()+1] %>, <%= date.getDate()+2 %>
                                <%= month[date.getMonth()] %> •</h2>
                    <div class="headliner">
                        <% items.slice(2, 3).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                    <div class="featured">
                        <% items.slice(9, 12).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                    <div class="other">
                        <% items.slice(24, 30).forEach(item=> { %>
                            <a target="_blank" href="https://open.spotify.com/artist/<%= item.id %>">
                                <%= item.name %>
                            </a>
                            <% }) %>
                    </div>
                </div>
            </div>
        </main>
        <aside>
            <h1>Customize your poster</h1>
            <section>
                <p>Poster title:</p>
                <form id="title">
                    <input type="text" maxlength="21" value="Your Spotify Festival">
                </form>
            </section>
            <section>
                <p>Choose your background:</p>
                <form id="background">
                    <label>
                        Beach
                        <img src="/static/images/beach.jpeg" width="100">
                        <input type="radio" id="beach" name="bg" checked>
                    </label>
                    <label for="party">
                        Party
                        <img src="/static/images/party.jpeg" width="100">
                        <input type="radio" id="party" name="bg">
                    </label>
                    <label for="winter">
                        Winter
                        <img src="/static/images/winter.jpeg" width="100">
                        <input type="radio" id="winter" name="bg">
                    </label>
                    <label for="custom">
                        Custom
                        <div>Custom</div>
                        <input type="radio" id="custom" name="bg">
                    </label>
                    <p class="source" id="beach">
                        <i class="fa-solid fa-link"></i> Source:
                        <a target="_blank"
                            href="https://www.pexels.com/photo/blue-textile-1078981/">https://www.pexels.com/photo/blue-textile-1078981/</a>
                    </p>
                    <p class="source" id="party">
                        <i class="fa-solid fa-link"></i> Source:
                        <a target="_blank"
                            href="https://www.pexels.com/photo/fireworks-during-night-time-1317365/">https://www.pexels.com/photo/fireworks-during-night-time-1317365/</a>
                    </p>
                    <p class="source" id="winter">
                        <i class="fa-solid fa-link"></i> Source:
                        <a target="_blank"
                            href="https://www.pexels.com/photo/person-standing-in-front-of-a-train-2422497/">https://www.pexels.com/photo/person-standing-in-front-of-a-train-2422497/</a>
                    </p>
                    <input type="text" id="customcolor" placeholder="Color (e.g. #202020)">
                    <input type="text" id="customimage" placeholder="Custom Image URL">
                </form>
            </section>
            <section>
                <p>Share Your Spotify Festival</p>
                <button id="download">Download image <i class="fa-solid fa-download"></i></button>
            </section>
            <footer>
                <p>Data & images provided by Spotify & Pexels. Not affiliated with Spotify or Pexels.</p>
                <p>Made with ❤️ by Casper den Nijs</p>
            </footer>
        </aside>
        <script src="/static/html2canvas.js"></script>
        <script src="/static/poster.js"></script>
</body>

</html>
